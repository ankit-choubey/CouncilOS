# CouncilOS environment template.
# Copy to .env and fill in. Never commit the real .env (it is gitignored).

# ── Worker API keys (used by API-backed workers, Milestone 3+) ──
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# ── Browser automation (used by browser-backed workers) ──
# Path to a persistent browser profile directory. Leave blank to use ./profiles/<model>.
BROWSER_PROFILE_DIR=

# ── Council behavior (used by core, future milestones) ──
# Max concurrent workers during fan-out.
COUNCILOS_MAX_CONCURRENCY=4
# Default per-worker timeout in seconds.
COUNCILOS_WORKER_TIMEOUT=120
