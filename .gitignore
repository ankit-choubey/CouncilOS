# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# Build / packaging
build/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
*.egg
MANIFEST
.installed.cfg

# Virtual environments
.venv/
venv/
ENV/
env/
active_env/

# ── Testing / coverage ──────────────────────────────────
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.pytest_cache/
.hypothesis/

# ── Type checkers / linters ─────────────────────────────
.mypy_cache/
.ruff_cache/

# ── Secrets & local config ──────────────────────────────
.env
.env.local
.env.*
!.env.example

# ── Editors / OS ───────────────────────────────────────
.idea/
.vscode/
.DS_Store
*.swp
*.swo

# ── Project artifacts (runtime, never committed) ───────
# Ignore the contents but keep the directories tracked via their .gitkeep.
/logs/*
!/logs/.gitkeep
/runs/*
!/runs/.gitkeep

# Persistent browser profiles (cookies, session state) — never committed.
/profiles/

# Session logs are ephemeral; keep the dir, ignore contents.
/planning/session_logs/*
!/planning/session_logs/.gitkeep

# Docs build
docs/_build/
